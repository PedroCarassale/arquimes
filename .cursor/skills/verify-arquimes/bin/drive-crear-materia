#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/../../../.." && pwd)"
CURRENT="$ROOT/.cursor/skills/verify-arquimes/run/current"
EVIDENCE="$ROOT/artifacts/verify-arquimes"
mkdir -p "$EVIDENCE"

if [[ ! -f "$CURRENT" ]]; then
  echo "drive-crear-materia: launch + doctor first" >&2
  exit 1
fi

# shellcheck disable=SC1090
source "$CURRENT"

if [[ "${BASE_URL:-}" == *"vercel.app"* ]]; then
  echo "drive-crear-materia: refuse production" >&2
  exit 1
fi

"$ROOT/.cursor/skills/verify-arquimes/bin/doctor"

TITLE="Verify Química $$"

cd "$ROOT"
node "$ROOT/.cursor/skills/verify-arquimes/bin/drive-crear-materia.mjs" \
  --base-url "$BASE_URL" \
  --user-data-dir "$USER_DATA_DIR" \
  --title "$TITLE" \
  --evidence "$EVIDENCE"
